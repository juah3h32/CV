---
import '../styles/global.css';
import { person, toolBars, buildSkills, aiRings, experience, gear, projects, photoItems, certifications, languages } from '../data/profile';

// Printable CV: two US-Letter sheets rendered from the same data as the
// portfolio page. `npm run cv` prints this route to public/cv-juan-pablo-corona.pdf.

const ico = {
  mail: '<rect x="3" y="5" width="18" height="14" rx="1"/><path d="M3 6l9 7 9-7"/>',
  phone: '<rect x="7" y="2" width="10" height="20" rx="2"/><line x1="11" y1="18" x2="13" y2="18"/>',
  pin: '<circle cx="12" cy="9" r="4"/><path d="M12 21l-4-8h8z"/>',
  globe: '<circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><line x1="3" y1="12" x2="21" y2="12"/>',
};
const [firstName, ...rest] = person.shortName.split(' ');
const lastWord = rest.pop();
---

<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>CV — {person.name}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <!-- SHEET 1 — header, profile, experience | skills sidebar -->
  <article class="sheet">
    <header class="cv-head">
      <!-- same pop-out as the site hero: the frame holds only the blurred glow,
           the cut-out overflows its top (head) and right edge (camera lens) -->
      <div class="cv-photo">
        <div class="cv-photo-frame">
          <img src="/images/yo-cv.jpg" alt="" aria-hidden="true" />
        </div>
        <img class="cv-photo-cut" src="/images/yo-cut-cv.png" alt={person.name} />
      </div>
      <div class="cv-id">
        <p class="cv-kicker">Curriculum Vitae</p>
        <h1>{firstName} {rest.join(' ')} <em>{lastWord}</em></h1>
        <p class="cv-title">{person.title}</p>
        <ul class="cv-contact">
          <li><svg viewBox="0 0 24 24" set:html={ico.phone} />{person.phone}</li>
          <li><svg viewBox="0 0 24 24" set:html={ico.mail} />{person.email}</li>
          <li><svg viewBox="0 0 24 24" set:html={ico.pin} />{person.location}</li>
          <li><svg viewBox="0 0 24 24" set:html={ico.globe} />{person.website}</li>
        </ul>
      </div>
    </header>

    <div class="cv-cols">
      <main class="cv-main">
        <section>
          <h2>Perfil</h2>
          <p class="cv-summary">{person.summary}</p>
        </section>

        <section>
          <h2>Experiencia <em>profesional</em></h2>
          <ol class="cv-jobs">
            {experience.map((job) => (
              <li class="cv-job">
                <div class="cv-job-top">
                  <h3>{job.company}</h3>
                  <span class="cv-period">{job.period}</span>
                </div>
                <p class="cv-role">{job.role}</p>
                <ul class="cv-points">
                  {job.points.map((pt) => <li>{pt}</li>)}
                </ul>
              </li>
            ))}
          </ol>
        </section>
      </main>

      <aside class="cv-side">
        <section>
          <h2>Habilidades</h2>
          <ul class="cv-bars">
            {buildSkills.map((s) => (
              <li>
                <span class="cv-bar-name">{s.name}</span>
                <span class="cv-bar"><i style={`width:${s.pct}%`}></i></span>
              </li>
            ))}
          </ul>
        </section>

        <section>
          <h2>Software</h2>
          <ul class="cv-tools">
            {toolBars.map((t) => (
              <li>
                <span class="cv-tool-tag" style={`background:${t.bg};color:${t.fg}`}>{t.tag}</span>
                <span class="cv-tool-name">{t.name}</span>
                <span class="cv-pct">{t.pct}%</span>
              </li>
            ))}
          </ul>
        </section>

        <section>
          <h2>IA y automatización</h2>
          <ul class="cv-tools">
            {aiRings.map((r) => (
              <li>
                <span class="cv-dot" style={`background:${r.bg}`}></span>
                <span class="cv-tool-name">{r.name}</span>
                <span class="cv-pct">{r.pct}%</span>
              </li>
            ))}
          </ul>
        </section>

      </aside>
    </div>
    <footer class="cv-foot"><span>{person.name}</span><span>1 / 2</span></footer>
  </article>

  <!-- SHEET 2 — projects, gear | education -->
  <article class="sheet">
    <header class="cv-head cv-head--mini">
      <h1>{firstName} {rest.join(' ')} <em>{lastWord}</em></h1>
      <p class="cv-title">{person.title}</p>
    </header>

    <section>
      <h2>Proyectos <em>destacados</em></h2>
      <div class="cv-projects">
        {projects.map((p) => (
          <figure class="cv-project">
            {p.image && <img src={p.image.replace('/projects/', '/projects/thumbs/').replace('.webp', '.jpg')} alt={`Captura de ${p.name}`} />}
            <figcaption>
              <strong>{p.name}</strong>
              <span>{p.desc}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section>
      <h2>Fotografía de <em>producto</em></h2>
      <div class="cv-photos">
        {photoItems.map((ph) => <img src={ph.image.replace('/photography/', '/photography/thumbs/')} alt={ph.name} />)}
      </div>
      <p class="cv-note">
        Sesiones de producto y comida para Naturizable, además de video con motion graphics 3D.
        Portafolio completo con video y galería en <strong>{person.website}</strong>.
      </p>
    </section>

    <div class="cv-cols cv-cols--even">
      <section>
        <h2>Equipo de <em>producción</em></h2>
        <dl class="cv-gear">
          {gear.map((g) => (
            <div>
              <dt>{g.title}</dt>
              <dd>{g.items.join(' · ')}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section>
        <h2>Educación</h2>
        <div class="cv-edu">
          <span class="cv-period">2018 — 2022</span>
          <h3>Universidad Tecnológica de Morelia</h3>
          <p>{person.degree} — Tecnologías de la Información</p>
        </div>
        <h2 class="cv-h2-gap">Certificaciones</h2>
        <ul class="cv-certs">
          {certifications.map((c) => <li>{c}</li>)}
        </ul>
        <p class="cv-lang">
          <strong>Idioma:</strong>{' '}
          {languages.map((l) => `${l.name} (${l.pct === 100 ? 'nativo' : `${l.pct}%`})`).join(' · ')}
        </p>
      </section>
    </div>

    <div class="cv-cta">
      <div>
        <p class="cv-cta-title">¿Trabajamos <em>juntos</em>?</p>
        <p>Disponible para videos corporativos, de producto y proyectos freelance.</p>
      </div>
      <ul class="cv-contact cv-contact--stack">
        <li><svg viewBox="0 0 24 24" set:html={ico.phone} />{person.phone}</li>
        <li><svg viewBox="0 0 24 24" set:html={ico.mail} />{person.email}</li>
      </ul>
    </div>
    <footer class="cv-foot"><span>{person.name}</span><span>2 / 2</span></footer>
  </article>

  <style>
    @page { size: letter; margin: 0; }
    html, body { background: #e8e8ed; }
    body { -webkit-print-color-adjust: exact; print-color-adjust: exact; letter-spacing: -0.01em; }

    /* one US-Letter sheet; on screen they stack like paper, in print each is a page */
    .sheet {
      position: relative;
      width: 8.5in;
      height: 11in;
      margin: 32px auto;
      padding: 0.45in 0.6in 0.5in;
      background: #fff;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.12);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }
    @media print {
      html, body { background: #fff; }
      .sheet { margin: 0; box-shadow: none; break-after: page; }
      .sheet:last-child { break-after: auto; }
    }

    h1, h2, h3 { margin: 0; }
    h2 {
      font-size: 26px;
      line-height: 1;
      margin-bottom: 9px;
      padding-bottom: 6px;
      border-bottom: 1.5px solid var(--gray-2);
    }
    .cv-h2-gap { margin-top: 14px; }
    .cv-lang { margin-top: 12px; font-size: 11.5px; color: var(--ink-soft); }
    .cv-lang strong { color: var(--ink); font-weight: 600; }

    /* HEADER */
    .cv-head { display: flex; gap: 26px; align-items: center; }
    .cv-photo {
      position: relative;
      flex: 0 0 140px;
      height: 186px;
      margin-top: -14px;
    }
    .cv-photo-frame {
      position: absolute;
      top: 20%; left: 0; right: 13%; bottom: 0;
      border-radius: 18px;
      overflow: hidden;
      background: #0d0d0f;
      box-shadow: 0 14px 30px -14px rgba(0, 0, 0, 0.5);
    }
    .cv-photo-frame img {
      position: absolute;
      inset: -10%;
      width: 120%;
      height: 120%;
      object-fit: cover;
      filter: blur(14px) saturate(1.3);
      opacity: 0.9;
    }
    .cv-photo-cut {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: drop-shadow(0 10px 14px rgba(0, 0, 0, 0.3));
    }
    .cv-kicker { font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
    .cv-id h1, .cv-head--mini h1 { font-size: 58px; line-height: 0.9; margin-top: 6px; }
    .cv-title { margin-top: 8px; font-size: 15px; font-weight: 500; color: var(--ink-soft); }
    .cv-contact {
      margin-top: 16px;
      display: grid;
      grid-template-columns: auto auto;
      gap: 7px 22px;
      font-size: 12.5px;
      color: var(--ink);
    }
    .cv-contact li { display: flex; align-items: center; gap: 8px; }
    .cv-contact svg {
      width: 22px; height: 22px;
      padding: 5px;
      flex-shrink: 0;
      border-radius: 50%;
      background: var(--accent-tint);
      fill: none;
      stroke: var(--accent);
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .cv-head--mini { display: block; padding-bottom: 4px; }
    .cv-head--mini h1 { font-size: 36px; }
    .sheet:last-child { gap: 14px; }

    /* COLUMNS */
    .cv-cols { display: grid; grid-template-columns: 1fr 2.35in; gap: 26px; flex: 1; min-height: 0; }
    .cv-cols--even { grid-template-columns: 1fr 1fr; flex: 0 0 auto; }
    .cv-main, .cv-side { display: flex; flex-direction: column; gap: 16px; }
    .cv-cols { align-items: start; }
    .cv-side {
      padding: 16px 16px 18px;
      border-radius: 16px;
      background: var(--gray);
    }
    .cv-side h2 { font-size: 22px; border-bottom-color: #dcdce1; }

    .cv-summary { font-size: 12px; line-height: 1.55; color: var(--ink-soft); }

    /* EXPERIENCE */
    .cv-jobs { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
    .cv-job { padding-left: 14px; border-left: 2px solid var(--gray-2); }
    .cv-job:first-child { border-left-color: var(--accent); }
    .cv-job-top { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
    .cv-job h3 { font-size: 21px; line-height: 1; }
    .cv-period { font-size: 11px; font-weight: 600; color: var(--ink-faint); white-space: nowrap; }
    .cv-role { margin-top: 2px; font-size: 12px; font-weight: 600; color: var(--accent); }
    .cv-points { margin-top: 4px; display: flex; flex-direction: column; gap: 1px; }
    .cv-points li { position: relative; padding-left: 11px; font-size: 11px; line-height: 1.38; color: var(--ink-soft); }
    .cv-points li::before {
      content: '';
      position: absolute;
      left: 0; top: 6.5px;
      width: 3.5px; height: 3.5px;
      border-radius: 50%;
      background: var(--ink-faint);
    }

    /* SIDEBAR */
    .cv-bars { display: flex; flex-direction: column; gap: 6px; }
    .cv-bars li { display: flex; flex-direction: column; gap: 4px; }
    .cv-bar-name { font-size: 11.5px; font-weight: 500; }
    .cv-bar { height: 4px; border-radius: 4px; background: #dcdce1; overflow: hidden; }
    .cv-bar i { display: block; height: 100%; border-radius: 4px; background: linear-gradient(90deg, #2445ff, #19b5fe); }
    .cv-tools { display: flex; flex-direction: column; gap: 5px; }
    .cv-tools li { display: flex; align-items: center; gap: 8px; font-size: 11.5px; }
    .cv-tool-tag {
      width: 20px; height: 20px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 5px;
      font-size: 8.5px;
      font-weight: 700;
      letter-spacing: 0;
    }
    .cv-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; margin: 0 6px 0 6px; }
    .cv-tool-name { flex: 1; font-weight: 500; }
    .cv-pct { font-size: 10.5px; color: var(--ink-faint); font-variant-numeric: tabular-nums; }

    /* PROJECTS */
    .cv-projects { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
    .cv-project { margin: 0; border-radius: 12px; overflow: hidden; background: var(--gray); }
    .cv-project img { width: 100%; aspect-ratio: 1100 / 509; object-fit: cover; display: block; }
    .cv-project figcaption { padding: 8px 11px 10px; display: flex; flex-direction: column; gap: 3px; }
    .cv-project strong { font-size: 12px; }
    .cv-project span { font-size: 10.5px; line-height: 1.4; color: var(--ink-soft); }
    .cv-photos { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; }
    .cv-photos img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 10px; display: block; }
    .cv-note { margin-top: 10px; font-size: 11.5px; color: var(--ink-soft); }

    /* GEAR / EDUCATION */
    .cv-gear { margin: 0; display: flex; flex-direction: column; gap: 8px; }
    .cv-gear div { display: grid; grid-template-columns: 78px 1fr; gap: 10px; font-size: 11.5px; }
    .cv-gear dt { font-weight: 600; }
    .cv-gear dd { margin: 0; color: var(--ink-soft); }
    .cv-edu h3 { margin-top: 4px; font-size: 21px; line-height: 1; }
    .cv-edu p { margin-top: 4px; font-size: 11.5px; color: var(--ink-soft); }
    .cv-certs { display: flex; flex-direction: column; gap: 5px; }
    .cv-certs li { position: relative; padding-left: 20px; font-size: 11.5px; }
    .cv-certs li::before {
      content: '✓';
      position: absolute;
      left: 0; top: 1px;
      width: 13px; height: 13px;
      border-radius: 50%;
      background: var(--accent);
      color: #fff;
      font-size: 8px;
      line-height: 13px;
      text-align: center;
    }

    /* CLOSING CTA */
    .cv-cta {
      margin-top: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      padding: 22px 26px;
      border-radius: 16px;
      background: #0f1020;
      color: #fff;
    }
    .cv-cta-title { font-family: var(--font-display); font-weight: 800; font-size: 34px; line-height: 1; text-transform: uppercase; }
    .cv-cta-title em {
      font-style: normal;
      background: linear-gradient(90deg, #4f6bff, #19b5fe);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .cv-cta p:not(.cv-cta-title) { margin-top: 6px; font-size: 12px; color: rgba(255, 255, 255, 0.7); }
    .cv-contact--stack { margin: 0; grid-template-columns: auto; color: #fff; }
    .cv-contact--stack svg { background: rgba(255, 255, 255, 0.12); stroke: #fff; }

    .cv-foot {
      position: absolute;
      left: 0.6in; right: 0.6in; bottom: 0.28in;
      display: flex;
      justify-content: space-between;
      font-size: 9.5px;
      color: var(--ink-faint);
    }
  </style>
</body>
</html>
