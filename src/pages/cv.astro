---
import '../styles/global.css';
import QRCode from 'qrcode';
import AppIcon from '../components/AppIcon.astro';
import {
  person, toolBars, buildSkills, aiRings, experience, gear, projects, photoItems,
  certifications, languages, appCase, stats, process,
} from '../data/profile';

// Printable CV: two US-Letter sheets rendered from the same data as the
// portfolio page. `npm run cv` prints this route to public/cv-juan-pablo-corona.pdf.
// Video-first ordering, no skill percentages (recruiters and ATS ignore them).

const ico = {
  mail: '<rect x="3" y="5" width="18" height="14" rx="1"/><path d="M3 6l9 7 9-7"/>',
  phone: '<rect x="7" y="2" width="10" height="20" rx="2"/><line x1="11" y1="18" x2="13" y2="18"/>',
  pin: '<circle cx="12" cy="9" r="4"/><path d="M12 21l-4-8h8z"/>',
  globe: '<circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><line x1="3" y1="12" x2="21" y2="12"/>',
  play: '<path d="M8 5v14l11-7z" fill="currentColor" stroke="none"/>',
};
const [firstName, ...rest] = person.shortName.split(' ');
const lastWord = rest.pop();

// key numbers strip: years, companies, cameras + the app
const keyNumbers = [
  { value: `${stats[0].value}${stats[0].suffix}`, label: 'Años creando contenido' },
  { value: String(stats[1].value), label: 'Empresas y marcas' },
  { value: String(stats[3].value), label: 'Cámaras profesionales' },
  { value: '1', label: 'App e-commerce' },
];
// jobs with few bullets collapse to a single line to save room
const compactFrom = 3;
const siteUrl = `https://${person.website}`;
const qrSvg = await QRCode.toString(siteUrl, { type: 'svg', margin: 0, color: { dark: '#0f1020', light: '#ffffff' } });
const gearNoEditing = gear.filter((g) => g.title !== 'Edición'); // already listed under Software
const featuredPhotos = photoItems.slice(0, 4);
---

<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>CV — {person.name}</title>
  <link rel="preload" href="/fonts/MorganitePro-ExtraBold.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600;700&display=swap" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <!-- SHEET 1 — header, key numbers, profile + experience | specialties, tools, process -->
  <article class="sheet">
    <header class="cv-head">
      <!-- same pop-out as the site hero: the frame holds only the blurred glow,
           the cut-out overflows its top (head) and right edge (camera lens) -->
      <div class="cv-photo">
        <div class="cv-photo-frame">
          <img src="/images/yo-cv.jpg" alt="" aria-hidden="true" />
        </div>
        <img class="cv-photo-cut" src="/images/yo-cut-cv.png" alt={person.name} />
      </div>
      <div class="cv-id">
        <p class="cv-kicker">Video · Fotografía · Diseño · Web</p>
        <h1>{firstName} {rest.join(' ')} <em>{lastWord}</em></h1>
        <p class="cv-title">{person.title}</p>
        <ul class="cv-contact">
          <li><svg viewBox="0 0 24 24" set:html={ico.phone} />{person.phone}</li>
          <li><svg viewBox="0 0 24 24" set:html={ico.mail} /><a href={`mailto:${person.email}`}>{person.email}</a></li>
          <li><svg viewBox="0 0 24 24" set:html={ico.pin} />{person.location}</li>
          <li><svg viewBox="0 0 24 24" set:html={ico.globe} /><a href={siteUrl}>{person.website}</a></li>
        </ul>
      </div>
    </header>

    <ul class="cv-numbers">
      {keyNumbers.map((n) => (
        <li><strong>{n.value}</strong><span>{n.label}</span></li>
      ))}
    </ul>

    <div class="cv-cols">
      <main class="cv-main">
        <section>
          <h2>Perfil</h2>
          <p class="cv-summary">
            Creador audiovisual: levanto contenido con cámara profesional y realizo videos
            corporativos y de producto, con fotografía, edición, color y motion graphics.
            Llevo cada pieza a la pantalla con diseño UI/UX, desarrollo web y app, y marketing
            con IA — entregas terminadas, listas para redes, campañas o el sitio de la marca.
          </p>
        </section>

        <section>
          <h2>Experiencia <em>profesional</em></h2>
          <ol class="cv-jobs">
            {experience.map((job, i) => (
              <li class={`cv-job ${i >= compactFrom ? 'cv-job--compact' : ''}`}>
                <div class="cv-job-top">
                  <h3>{job.company}</h3>
                  <span class="cv-period">{job.period}</span>
                </div>
                <p class="cv-role">{job.role}</p>
                {i >= compactFrom ? (
                  <p class="cv-points-inline">{job.points.join(' ')}</p>
                ) : (
                  <ul class="cv-points">
                    {job.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        </section>
      </main>

      <aside class="cv-side">
        <section>
          <h2>Especialidades</h2>
          <ul class="cv-chips">
            {buildSkills.map((s) => <li>{s.name}</li>)}
          </ul>
        </section>

        <section>
          <h2>Software</h2>
          <ul class="cv-icons">
            {toolBars.map((t) => (
              <li><AppIcon tool={t} size={20} /><span>{t.name.replace('Adobe ', '')}</span></li>
            ))}
          </ul>
        </section>

        <section>
          <h2>IA y automatización</h2>
          <ul class="cv-icons">
            {aiRings.map((r) => (
              <li><AppIcon tool={r} size={20} /><span>{r.name.replace('Automatización ', '')}</span></li>
            ))}
          </ul>
        </section>

        <section>
          <h2>Cómo trabajo</h2>
          <ol class="cv-steps">
            {process.map((p, i) => (
              <li>
                <span class="cv-step-n">{String(i + 1).padStart(2, '0')}</span>
                <strong>{p.title}</strong>
              </li>
            ))}
          </ol>
        </section>
      </aside>
    </div>
    <footer class="cv-foot"><span>{person.name}</span><span>1 / 2</span></footer>
  </article>

  <!-- SHEET 2 — TPN case, video & photo, sites | gear, education, CTA with QR -->
  <article class="sheet">
    <header class="cv-head cv-head--mini">
      <h1>{firstName} {rest.join(' ')} <em>{lastWord}</em></h1>
      <p class="cv-title">{person.title}</p>
    </header>

    <section class="cv-app">
      <div class="cv-phones" aria-hidden="true">
        <div class="cv-phone cv-phone--back"><img src={appCase.screens[2].image} alt="" /></div>
        <div class="cv-phone"><img src={appCase.screens[0].image} alt="" /></div>
      </div>
      <div class="cv-app-copy">
        <p class="cv-kicker">Caso destacado · App móvil</p>
        <h2 class="cv-app-title">{appCase.name}, <em>e-commerce</em> a domicilio</h2>
        <p class="cv-app-lead">
          App estilo Rappi para que los negocios pidan sus insumos desde el celular:
          catálogo, carrito y entrega a domicilio. Diseño y desarrollo completos con apoyo de IA.
        </p>
        <ul class="cv-app-features">
          {appCase.features.map((f) => <li>{f.text}</li>)}
        </ul>
        <ul class="cv-chips cv-chips--light">{appCase.tags.map((t) => <li>{t}</li>)}</ul>
      </div>
    </section>

    <section>
      <h2>Video y <em>fotografía</em></h2>
      <div class="cv-media">
        <figure class="cv-media-video">
          <img src="/images/projects/thumbs/motion-graphics.jpg" alt="Motion graphics 3D" />
          <span class="cv-play"><svg viewBox="0 0 24 24" set:html={ico.play} /></span>
          <figcaption>Motion graphics 3D</figcaption>
        </figure>
        {featuredPhotos.map((ph) => <img src={ph.image.replace('/photography/', '/photography/thumbs/')} alt={ph.name} />)}
      </div>
    </section>

    <div class="cv-cols cv-cols--even">
      <section>
        <h2>Sitios <em>web</em></h2>
        <ul class="cv-sites">
          {projects.map((p) => (
            <li>
              {p.image && <img src={p.image.replace('/projects/', '/projects/thumbs/').replace('.webp', '.jpg')} alt={`Captura de ${p.name}`} />}
              <div><strong>{p.name}</strong><span>{p.desc}</span></div>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Equipo de <em>producción</em></h2>
        <dl class="cv-gear">
          {gearNoEditing.map((g) => (
            <div>
              <dt>{g.title}</dt>
              <dd>{g.items.join(' · ')}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>

    <section>
      <h2>Educación y <em>certificaciones</em></h2>
      <div class="cv-edu-row">
        <div class="cv-edu">
          <span class="cv-period">2018 — 2022</span>
          <h3>Universidad Tecnológica de Morelia</h3>
          <p>{person.degree} — Tecnologías de la Información</p>
          <p class="cv-lang">
            <strong>Idioma:</strong>{' '}
            {languages.map((l) => `${l.name} (${l.pct === 100 ? 'nativo' : `${l.pct}%`})`).join(' · ')}
          </p>
        </div>
        <ul class="cv-certs">
          {certifications.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </section>

    <div class="cv-cta">
      <div class="cv-cta-text">
        <p class="cv-cta-title">¿Trabajamos <em>juntos</em>?</p>
        <p>Disponible para videos corporativos, de producto y proyectos freelance.</p>
        <ul class="cv-contact cv-contact--stack">
          <li><svg viewBox="0 0 24 24" set:html={ico.phone} />{person.phone}</li>
          <li><svg viewBox="0 0 24 24" set:html={ico.mail} /><a href={`mailto:${person.email}`}>{person.email}</a></li>
        </ul>
      </div>
      <a class="cv-qr" href={siteUrl}>
        <span class="cv-qr-code" set:html={qrSvg} />
        <span>Escanea para ver<br />video y portafolio<br /><strong>{person.website}</strong></span>
      </a>
    </div>
    <footer class="cv-foot"><span>{person.name}</span><span>2 / 2</span></footer>
  </article>

  <style>
    @page { size: letter; margin: 0; }
    html, body { background: #e8e8ed; }
    body { -webkit-print-color-adjust: exact; print-color-adjust: exact; letter-spacing: -0.01em; }

    /* one US-Letter sheet; on screen they stack like paper, in print each is a page */
    .sheet {
      position: relative;
      width: 8.5in;
      height: 11in;
      margin: 32px auto;
      padding: 0.45in 0.6in 0.5in;
      background: #fff;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.12);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      gap: 13px;
    }
    @media print {
      html, body { background: #fff; }
      .sheet { margin: 0; box-shadow: none; break-after: page; }
      .sheet:last-child { break-after: auto; }
    }

    h1, h2, h3 { margin: 0; }
    h2 {
      font-size: 24px;
      line-height: 1;
      margin-bottom: 9px;
      padding-bottom: 6px;
      border-bottom: 1.5px solid var(--gray-2);
    }
    a { color: inherit; text-decoration: none; }

    /* HEADER */
    .cv-head { display: flex; gap: 26px; align-items: center; }
    /* exactly the cut-out's 2:3 ratio, so object-fit never trims the head */
    .cv-photo {
      position: relative;
      flex: 0 0 120px;
      height: 180px;
      margin-top: -6px;
    }
    .cv-photo-frame {
      position: absolute;
      top: 20%; left: 0; right: 13%; bottom: 0;
      border-radius: 18px;
      overflow: hidden;
      background: #0d0d0f;
      box-shadow: 0 14px 30px -14px rgba(0, 0, 0, 0.5);
    }
    .cv-photo-frame img {
      position: absolute;
      inset: -10%;
      width: 120%;
      height: 120%;
      object-fit: cover;
      filter: blur(14px) saturate(1.3);
      opacity: 0.9;
    }
    .cv-photo-cut {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: bottom center;
      filter: drop-shadow(0 10px 14px rgba(0, 0, 0, 0.3));
    }
    .cv-kicker { font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
    .cv-id h1 { font-size: 56px; line-height: 0.9; margin-top: 6px; }
    .cv-title { margin-top: 7px; font-size: 14.5px; font-weight: 500; color: var(--ink-soft); }
    .cv-contact {
      margin-top: 14px;
      display: grid;
      grid-template-columns: auto auto;
      gap: 6px 22px;
      font-size: 12px;
      color: var(--ink);
    }
    .cv-contact li { display: flex; align-items: center; gap: 8px; }
    .cv-contact svg {
      width: 22px; height: 22px;
      padding: 5px;
      flex-shrink: 0;
      border-radius: 50%;
      background: var(--accent-tint);
      fill: none;
      stroke: var(--accent);
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .cv-head--mini { display: block; }
    .cv-head--mini h1 { font-size: 34px; }

    /* KEY NUMBERS */
    .cv-numbers {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      border-radius: 14px;
      background: var(--gray);
      overflow: hidden;
    }
    .cv-numbers li { display: flex; align-items: center; gap: 10px; padding: 10px 16px; border-left: 1px solid #e3e3e8; }
    .cv-numbers li:first-child { border-left: 0; }
    .cv-numbers strong {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 38px;
      line-height: 0.85;
      background: linear-gradient(180deg, #2445ff, #19b5fe);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .cv-numbers span { font-size: 10.5px; line-height: 1.25; font-weight: 600; color: var(--ink-soft); }

    /* COLUMNS */
    .cv-cols { display: grid; grid-template-columns: 1fr 2.4in; gap: 24px; flex: 1; min-height: 0; align-items: start; }
    .cv-cols--even { grid-template-columns: 1fr 1fr; flex: 0 0 auto; }
    .cv-main, .cv-side { display: flex; flex-direction: column; gap: 14px; }
    .cv-side { gap: 12px; }
    .cv-side { padding: 14px 15px 16px; border-radius: 16px; background: var(--gray); }
    .cv-side h2 { font-size: 20px; border-bottom-color: #dcdce1; margin-bottom: 8px; }

    .cv-summary { font-size: 12px; line-height: 1.55; color: var(--ink-soft); }

    /* EXPERIENCE */
    .cv-jobs { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 9px; }
    .cv-job { padding-left: 14px; border-left: 2px solid var(--gray-2); }
    .cv-job:first-child { border-left-color: var(--accent); }
    .cv-job-top { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
    .cv-job h3 { font-size: 20px; line-height: 1; }
    .cv-period { font-size: 11px; font-weight: 600; color: var(--ink-faint); white-space: nowrap; }
    .cv-role { margin-top: 2px; font-size: 11.5px; font-weight: 600; color: var(--accent); }
    .cv-points { margin-top: 4px; display: flex; flex-direction: column; gap: 1px; }
    .cv-points li { position: relative; padding-left: 11px; font-size: 11px; line-height: 1.38; color: var(--ink-soft); }
    .cv-points li::before {
      content: '';
      position: absolute;
      left: 0; top: 6.5px;
      width: 3.5px; height: 3.5px;
      border-radius: 50%;
      background: var(--ink-faint);
    }
    .cv-points-inline { margin-top: 3px; font-size: 11px; line-height: 1.38; color: var(--ink-soft); }

    /* SIDEBAR */
    .cv-chips { display: flex; flex-wrap: wrap; gap: 5px; }
    .cv-chips li {
      font-size: 10.5px;
      font-weight: 600;
      padding: 4px 9px;
      border-radius: 980px;
      background: #fff;
      color: var(--ink);
    }
    .cv-chips li:nth-child(-n + 4) { background: var(--accent); color: #fff; } /* video/photo first */
    .cv-icons { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 8px; }
    .cv-icons li { display: flex; align-items: center; gap: 7px; font-size: 11px; font-weight: 500; min-width: 0; }
    .cv-icons span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cv-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .cv-steps li { display: flex; align-items: center; gap: 6px; }
    .cv-step-n { font-family: var(--font-display); font-weight: 800; font-size: 20px; line-height: 0.9; color: var(--accent); }
    .cv-steps strong { font-size: 11px; line-height: 1.2; }

    /* TPN APP CASE */
    .cv-app {
      display: grid;
      grid-template-columns: 170px 1fr;
      gap: 22px;
      align-items: center;
      padding: 12px 20px 12px 12px;
      border-radius: 18px;
      background: linear-gradient(120deg, #fff4f4, #f5f5f7 60%);
    }
    .cv-phones { position: relative; height: 192px; }
    .cv-phone {
      position: absolute;
      top: 0; left: 46px;
      width: 96px;
      padding: 4px;
      border-radius: 18px;
      background: #121214;
      box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.45);
    }
    .cv-phone img { display: block; width: 100%; border-radius: 14px; }
    .cv-phone--back { left: 8px; top: 14px; transform: rotate(-8deg) scale(0.92); opacity: 0.9; }
    .cv-app h2.cv-app-title { font-size: 30px; border: 0; padding: 0; margin: 4px 0 6px; }
    .cv-app-lead { font-size: 11.5px; line-height: 1.5; color: var(--ink-soft); }
    .cv-app-features { margin-top: 8px; display: grid; grid-template-columns: 1fr 1fr; gap: 3px 16px; }
    .cv-app-features li { position: relative; padding-left: 12px; font-size: 10.5px; line-height: 1.35; }
    .cv-app-features li::before {
      content: '';
      position: absolute;
      left: 0; top: 5px;
      width: 5px; height: 5px;
      border-radius: 50%;
      background: #e31b23;
    }
    .cv-chips--light { margin-top: 9px; }
    .cv-chips--light li, .cv-chips--light li:nth-child(-n + 4) { background: #fff; color: var(--ink-soft); }

    /* VIDEO & PHOTO */
    .cv-media { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr 1fr; gap: 8px; }
    .cv-media > img { width: 100%; height: 92px; object-fit: cover; border-radius: 10px; display: block; }
    .cv-media-video { position: relative; margin: 0; height: 92px; border-radius: 10px; overflow: hidden; }
    .cv-media-video img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .cv-play {
      position: absolute;
      top: 50%; left: 50%;
      width: 30px; height: 30px;
      margin: -15px 0 0 -15px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.9);
      color: #0f1020;
    }
    .cv-play svg { width: 14px; height: 14px; margin-left: 2px; }
    .cv-media-video figcaption {
      position: absolute;
      left: 8px; bottom: 6px;
      font-size: 10px;
      font-weight: 600;
      color: #fff;
    }

    /* SITES */
    .cv-sites { display: flex; flex-direction: column; gap: 8px; }
    .cv-sites li { display: grid; grid-template-columns: 92px 1fr; gap: 10px; align-items: center; }
    .cv-sites img { width: 92px; aspect-ratio: 1100 / 509; object-fit: cover; border-radius: 7px; display: block; }
    .cv-sites strong { display: block; font-size: 11.5px; }
    .cv-sites span { display: block; font-size: 10px; line-height: 1.35; color: var(--ink-soft); }

    /* GEAR */
    .cv-gear { margin: 0; display: flex; flex-direction: column; gap: 7px; }
    .cv-gear div { display: grid; grid-template-columns: 74px 1fr; gap: 8px; font-size: 11px; }
    .cv-gear dt { font-weight: 600; }
    .cv-gear dd { margin: 0; color: var(--ink-soft); }

    /* EDUCATION */
    .cv-edu-row { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    .cv-edu h3 { margin-top: 4px; font-size: 20px; line-height: 1; }
    .cv-edu p { margin-top: 4px; font-size: 11px; color: var(--ink-soft); }
    .cv-lang { margin-top: 8px !important; }
    .cv-lang strong { color: var(--ink); font-weight: 600; }
    .cv-certs { display: flex; flex-direction: column; gap: 5px; }
    .cv-certs li { position: relative; padding-left: 20px; font-size: 11px; }
    .cv-certs li::before {
      content: '✓';
      position: absolute;
      left: 0; top: 1px;
      width: 13px; height: 13px;
      border-radius: 50%;
      background: var(--accent);
      color: #fff;
      font-size: 8px;
      line-height: 13px;
      text-align: center;
    }

    /* CLOSING CTA + QR */
    .cv-cta {
      margin-top: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      padding: 18px 20px 18px 26px;
      border-radius: 16px;
      background: #0f1020;
      color: #fff;
    }
    .cv-cta-title { font-family: var(--font-display); font-weight: 800; font-size: 32px; line-height: 1; text-transform: uppercase; }
    .cv-cta-title em {
      font-style: normal;
      background: linear-gradient(90deg, #4f6bff, #19b5fe);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .cv-cta-text > p:not(.cv-cta-title) { margin-top: 5px; font-size: 11.5px; color: rgba(255, 255, 255, 0.7); }
    .cv-contact--stack { margin-top: 10px; grid-template-columns: auto auto; color: #fff; }
    .cv-contact--stack svg { background: rgba(255, 255, 255, 0.12); stroke: #fff; }
