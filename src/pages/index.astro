---
import '../styles/global.css';
import fs from 'node:fs';
import AppIcon from '../components/AppIcon.astro';
import { toolBars, buildSkills, aiRings, experience, gear, projects, photoItems, certifications, languages } from '../data/profile';

// Minimal line-icon set — straight-line/primitive SVG only (no curve commands)
// so every glyph renders identically everywhere, no icon-font dependency.
const icons: Record<string, string> = {
  image: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.6"/><path d="M21 15l-5-5-11 11"/>',
  vector: '<path d="M4 20l7-16 3 8h6"/><circle cx="4" cy="20" r="1.3"/><circle cx="11" cy="4" r="1.3"/><circle cx="20" cy="12" r="1.3"/>',
  film: '<rect x="3" y="4" width="18" height="16" rx="1"/><line x1="8" y1="4" x2="8" y2="20"/><line x1="16" y1="4" x2="16" y2="20"/><line x1="3" y1="9" x2="8" y2="9"/><line x1="3" y1="15" x2="8" y2="15"/><line x1="16" y1="9" x2="21" y2="9"/><line x1="16" y1="15" x2="21" y2="15"/>',
  sparkle: '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/>',
  clapper: '<path d="M3 9l17-4 1 4-17 4z"/><rect x="3" y="9" width="18" height="11" rx="1"/><line x1="7" y1="9" x2="9" y2="5.5"/><line x1="12.5" y1="8" x2="14.5" y2="4.5"/>',
  grid: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>',
  aperture: '<circle cx="12" cy="12" r="9"/><line x1="12" y1="3" x2="12" y2="9"/><line x1="21" y1="12" x2="15" y2="12"/><line x1="12" y1="21" x2="12" y2="15"/><line x1="3" y1="12" x2="9" y2="12"/>',
  camera: '<path d="M4 8h3l2-2h6l2 2h3v11H4z"/><circle cx="12" cy="13.5" r="3.5"/>',
  drone: '<circle cx="12" cy="12" r="2"/><line x1="12" y1="12" x2="5" y2="5"/><line x1="12" y1="12" x2="19" y2="5"/><line x1="12" y1="12" x2="5" y2="19"/><line x1="12" y1="12" x2="19" y2="19"/><circle cx="5" cy="5" r="2"/><circle cx="19" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="19" cy="19" r="2"/>',
  light: '<circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="22"/><line x1="2" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="22" y2="12"/><line x1="4.9" y1="4.9" x2="7" y2="7"/><line x1="17" y1="17" x2="19.1" y2="19.1"/><line x1="4.9" y1="19.1" x2="7" y2="17"/><line x1="17" y1="7" x2="19.1" y2="4.9"/>',
  audio: '<rect x="9" y="3" width="6" height="10" rx="3"/><line x1="5" y1="11" x2="5" y2="13"/><line x1="19" y1="11" x2="19" y2="13"/><line x1="12" y1="17" x2="12" y2="21"/><line x1="8" y1="21" x2="16" y2="21"/>',
  edit: '<path d="M4 20l1-4L16 5l3 3L8 19z"/><line x1="14" y1="7" x2="17" y2="10"/>',
  phone: '<rect x="7" y="2" width="10" height="20" rx="2"/><line x1="11" y1="18" x2="13" y2="18"/>',
  globe: '<circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><line x1="3" y1="12" x2="21" y2="12"/>',
  pin: '<circle cx="12" cy="9" r="4"/><path d="M12 21l-4-8h8z"/>',
  download: '<line x1="12" y1="3" x2="12" y2="14"/><polyline points="7,9 12,14 17,9"/><line x1="5" y1="19" x2="19" y2="19"/>',
  arrow: '<line x1="6" y1="18" x2="18" y2="6"/><polyline points="8,6 18,6 18,16"/>',
  home: '<path d="M4 11l8-7 8 7"/><path d="M6 10v10h12V10"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-7 8-7s8 3 8 7"/>',
  briefcase: '<rect x="3" y="7" width="18" height="13" rx="1"/><path d="M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="1"/><path d="M3 6l9 7 9-7"/>',
  brackets: '<polyline points="8,4 2,12 8,20"/><polyline points="16,4 22,12 16,20"/>',
  droplet: '<path d="M12 3l6 10a6 6 0 11-12 0z"/>',
  bolt: '<path d="M12 2L5 14h5l-1 8 9-12h-6z"/>',
  devices: '<rect x="2" y="4" width="14" height="10" rx="1"/><rect x="18" y="7" width="5" height="12" rx="1"/>',
  search: '<circle cx="10" cy="10" r="6"/><line x1="15" y1="15" x2="21" y2="21"/>',
  layers: '<polyline points="12,3 21,8 12,13 3,8 12,3"/><polyline points="3,13 12,18 21,13"/>',
  chip: '<rect x="6" y="6" width="12" height="12" rx="2"/><line x1="9" y1="2" x2="9" y2="6"/><line x1="15" y1="2" x2="15" y2="6"/><line x1="9" y1="18" x2="9" y2="22"/><line x1="15" y1="18" x2="15" y2="22"/><line x1="2" y1="9" x2="6" y2="9"/><line x1="2" y1="15" x2="6" y2="15"/><line x1="18" y1="9" x2="22" y2="9"/><line x1="18" y1="15" x2="22" y2="15"/>',
  sun: '<circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="22"/><line x1="2" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="22" y2="12"/><line x1="4.9" y1="4.9" x2="7" y2="7"/><line x1="17" y1="17" x2="19.1" y2="19.1"/><line x1="4.9" y1="19.1" x2="7" y2="17"/><line x1="17" y1="7" x2="19.1" y2="4.9"/>',
  moon: '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>',
};

const nav = [
  { href: '#top', label: 'Inicio', icon: 'home' },
  { href: '#projects', label: 'Proyectos', icon: 'image' },
  { href: '#about', label: 'Sobre mí', icon: 'user' },
  { href: '#experience', label: 'Experiencia', icon: 'briefcase' },
  { href: '#skills', label: 'Habilidades', icon: 'grid' },
  { href: '#gear', label: 'Equipo', icon: 'camera' },
  { href: '#contact', label: 'Contacto', icon: 'mail' },
];

const stats = [
  { value: 5, suffix: '+', label: 'Años de experiencia' },
  { value: 6, suffix: '', label: 'Empresas / marcas' },
  { value: 3, suffix: '', label: 'Proyectos destacados' },
  { value: 5, suffix: '', label: 'Cámaras profesionales' },
];

// "Cómo trabajo" — the four steps every project goes through
const process = [
  { title: 'Idea y guion', desc: 'Entiendo la marca y el objetivo, y armo concepto, guion y lista de tomas antes de grabar.', icon: 'search' },
  { title: 'Grabación', desc: 'Cámaras Sony, drones DJI, iluminación y audio profesional para foto y video de producto.', icon: 'camera' },
  { title: 'Edición y post', desc: 'Montaje, color, motion graphics y retoque en Premiere, After Effects, DaVinci y Photoshop.', icon: 'film' },
  { title: 'Publicar y medir', desc: 'Formatos para redes, campañas y web, con métricas y reportes automatizados con IA.', icon: 'bolt' },
];

// The tile grid shows only the five most-used apps in one row — video
// and photo first; the marquee above it still lists every tool.
const topTools = ['Adobe Premiere Pro', 'Adobe After Effects', 'DaVinci Resolve', 'Adobe Photoshop', 'Lightroom']
  .map((name) => toolBars.find((t) => t.name === name)!);

// Real brand colors for project tag chips, matching the tech-ring badges
const tagMeta: Record<string, { icon: string; bg: string; fg: string }> = {
  HTML: { icon: 'brackets', bg: '#E34F26', fg: '#fff' },
  CSS: { icon: 'droplet', bg: '#1572B6', fg: '#fff' },
  JS: { icon: 'bolt', bg: '#F7DF1E', fg: '#1a1a1a' },
  GSAP: { icon: 'sparkle', bg: '#88CE02', fg: '#0b1a00' },
};

// Fotografía / Video slots — waiting on real files (public/images/projects/
// for photos, public/images/projects/ + a poster frame for video). Each
// renders as an empty upload-style placeholder until an `image` is added.
// Items with a `src` render as a playing video card; the rest are empty slots
// waiting for more clips in public/video/.
const videoItems: { name: string; desc: string; src?: string; tags?: string[] }[] = [
  { name: 'Motion graphics 3D', desc: 'Animación de logotipos y tecnologías con iluminación, partículas y edición final.', src: '/video/product-animation.mp4', tags: ['After Effects', 'Premiere Pro', 'Motion'] },
];

// Only loop-animate a track once it has more than 3 items — with 3 or
// fewer everything already fits without scrolling, so keep it static.
const loopItems = <T,>(arr: T[]) => (arr.length > 3 ? [...arr, ...arr] : arr);

// astro:assets needs static, literal import paths to optimize a file, so at
// build time we just check whether the file actually landed on disk yet —
// no image means we fall back to the gradient placeholder instead of a 404.
// Remote (http/https) images skip this check — the browser loads those
// directly at runtime, there's nothing on disk to verify.
for (const p of projects) {
  if (p.image?.startsWith('http')) continue;
  const onDisk = fs.existsSync(new URL('../../public' + p.image, import.meta.url));
  if (!onDisk) delete (p as any).image;
}

---

<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Juan Pablo Corona Corona — Videógrafo, editor y creador de contenido digital. Video y fotografía de producto, motion graphics, diseño, desarrollo web y marketing con IA." />
  <title>Juan Pablo Corona — Video, Fotografía y Contenido Digital</title>
  <link rel="preload" href="/fonts/MorganitePro-ExtraBold.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600;700&display=swap" />
  <script is:inline>
    // Hide the first view until fonts load, so text never flashes in a fallback face.
    document.documentElement.classList.add('fonts-loading');
    setTimeout(() => document.documentElement.classList.remove('fonts-loading'), 2500);
  </script>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#ffffff" />
</head>
<body>

  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" id="lightboxClose" aria-label="Cerrar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/></svg>
    </button>
    <figure class="lightbox-figure">
      <img class="lightbox-img" id="lightboxImg" src="" alt="" />
      <figcaption class="lightbox-caption" id="lightboxCaption"></figcaption>
    </figure>
  </div>

  <header class="nav" id="siteNav">
    <div class="wrap nav-inner">
      <a href="#top" class="brand">Juan Pablo Corona</a>
      <nav class="nav-links" id="navLinks">
        {nav.map((item) => (
          <a href={item.href} data-nav>{item.label}</a>
        ))}
      </nav>
      <div class="nav-cta">
        <a href="/cv-juan-pablo-corona.pdf" download="CV-Juan-Pablo-Corona.pdf" class="btn btn-primary btn-sm">Descargar CV</a>
      </div>
      <button class="nav-toggle" id="navToggle" aria-label="Abrir menú">
        <span></span><span></span>
      </button>
    </div>
  </header>

  <main id="top">

    <!-- HERO -->
    <section class="hero section--white">
      <div class="wrap hero-inner">
        <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">Video · Fotografía · Diseño · Web</p>
        <h1 class="hero-name">Juan Pablo <em>Corona</em></h1>
        <p class="hero-sub">
          Levanto contenido con cámara profesional y realizo videos corporativos y de
          producto — y llevo cada pieza a la pantalla con diseño, web, marketing e IA.
        </p>
        <div class="hero-actions">
          <a href="#projects" class="btn btn-primary">Ver proyectos</a>
          <a href="#contact" class="text-link">
            Hablemos
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9,5 16,12 9,19"/></svg>
          </a>
        </div>
        <div class="hero-social">
          <a href="mailto:Coronapablo99@gmail.com" aria-label="Email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons.mail} />
          </a>
          <a href="tel:4434845466" aria-label="Teléfono">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons.phone} />
          </a>
        </div>
        <p class="hero-meta">Ing. Entornos Virtuales y Negocios Digitales · Morelia, Michoacán, México</p>
        </div>
        <!-- Pop-out portrait: the framed card holds only the blurred glow of the
             photo; the cut-out of me sits on a closer 3D layer and breaks out
             past the frame's top and right edges. -->
        <figure class="hero-photo" id="heroPhoto">
          <div class="hero-stage">
            <div class="hero-frame">
              <img class="hero-glow" src="/images/yo.webp" alt="" aria-hidden="true" />
            </div>
            <img class="hero-cutout" src="/images/yo-cut.webp" alt="Juan Pablo Corona con cámara de cine en gimbal" width="1024" height="1536" fetchpriority="high" />
            <figcaption class="hero-badge">
              <a href="#contact" class="hero-badge-card">
                <span class="hero-badge-dot" aria-hidden="true"></span>
                <span class="hero-badge-text">
                  <strong>Disponible</strong>
                  <span>para nuevos proyectos</span>
                </span>
                <span class="hero-badge-go" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="8,7 17,7 17,16"/></svg>
                </span>
              </a>
            </figcaption>
          </div>
        </figure>
      </div>
    </section>

    <!-- PROJECTS -->
    <section class="section projects section--gray" id="projects">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Proyectos</p>
          <h2>Trabajo <em>seleccionado</em>.</h2>
          <p>Video, fotografía de producto y sitios web — producidos y entregados de principio a fin.</p>
        </div>

        <div class="seg-wrap" data-reveal>
          <div class="seg" id="projectTabs" role="tablist">
            <span class="seg-thumb" aria-hidden="true"></span>
            <button class="project-tab is-active" data-filter="video" role="tab" aria-selected="true">Video</button>
            <button class="project-tab" data-filter="foto" role="tab" aria-selected="false">Fotografía</button>
            <button class="project-tab" data-filter="web" role="tab" aria-selected="false">Web</button>
          </div>
        </div>
      </div>

      <div class="project-carousel">
        <div class={`project-track ${projects.length > 3 ? 'project-track--loop' : ''}`} data-group="web" style="display:none;">
          {loopItems(projects).map((p, i) => (
            <a class="project-card" href={p.url} target="_blank" rel="noopener noreferrer" aria-hidden={i >= projects.length ? 'true' : undefined}>
              <div class={`project-thumb ${p.image ? 'has-image' : 'thumb-empty'}`}>
                {p.image && <img class="project-thumb-img" src={p.image} alt={`Captura de ${p.name}`} loading="lazy" />}
              </div>
              <div class="project-body">
                <div class="project-title-row">
                  <h3>{p.name}</h3>
                  <svg class="project-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons.arrow} />
                </div>
                <p>{p.desc}</p>
                <div class="project-tags">
                  {p.tags.map((t) => <span>{t}</span>)}
                </div>
              </div>
            </a>
          ))}
        </div>

        <!-- Fotografía: product rail — photos hang turned sideways and swing to the front on hover -->
        <div class="project-track photo-rail-wrap" data-group="foto" style="display:none;">
          <div class="photo-rail" id="photoRail">
            <span class="photo-rail-bar" aria-hidden="true"></span>
            {photoItems.map((p, i) => (
              <button
                type="button"
                class={`rail-item ${i === 0 ? 'is-front' : ''}`}
                data-index={i}
                data-lightbox={p.image}
                data-lightbox-caption={p.name}
                data-desc={p.desc}
                aria-label={p.name}
              >
                <span class="rail-hook" aria-hidden="true"></span>
                <span class="rail-swing">
                  <span class="rail-turn">
                    <img src={p.image} alt={p.name} loading="lazy" draggable="false" />
                    <span class="rail-shade" aria-hidden="true"></span>
                  </span>
                </span>
              </button>
            ))}
          </div>
          <div class="rail-caption" aria-live="polite">
            <p class="rail-caption-name" id="railName">{photoItems[0].name}</p>
            <p class="rail-caption-desc" id="railDesc">{photoItems[0].desc}</p>
          </div>
        </div>

        <div class="project-track" data-group="video">
          {videoItems.map((v) => v.src ? (
            <div class="project-card project-card--video">
              <div class="project-video">
                <video src={v.src} muted loop playsinline preload="metadata" autoplay></video>
                <button type="button" class="video-sound" aria-label="Activar sonido">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5L6 9H3v6h3l5 4z"/><line x1="22" y1="9" x2="16" y2="15"/><line x1="16" y1="9" x2="22" y2="15"/></svg>
                </button>
              </div>
              <div class="project-body">
                <h3>{v.name}</h3>
                <p>{v.desc}</p>
                <div class="project-tags">{v.tags?.map((t) => <span>{t}</span>)}</div>
              </div>
            </div>
          ) : (
            <div class="project-card project-card--empty">
              <div class="project-empty-slot">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={icons.film} />
              </div>
              <div class="project-body">
                <h3>{v.name}</h3>
                <p>{v.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ABOUT -->
    <section class="section about section--white" id="about">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Sobre mí</p>
          <h2>5 años de <em>imagen y movimiento</em>.</h2>
          <p>
            Creador audiovisual enfocado en videos corporativos, de producto y fotografía: grabación con
            cámara, drones e iluminación, edición, color y motion graphics. Además diseño,
            desarrollo web y marketing digital con IA, así que cada video llega terminado a
            donde tiene que vivir — redes, campañas o el sitio de la marca.
          </p>
        </div>
        <div class="bento">
          <!-- Services: one bento card per discipline, each with its own small live visual -->
          <div class="bento-card svc svc--photo reveal-card">
            <img src="/images/photography/papas-alitas.jpg" alt="" loading="lazy" />
            <div class="svc-copy">
              <span class="svc-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icons.camera} /></span>
              <h3>Video y fotografía</h3>
              <p>Videos corporativos y de producto con cámara profesional, drones e iluminación — de la grabación a la edición, color y motion graphics.</p>
              <div class="svc-chips svc-chips--dark"><span>Sony FX3 / A7III</span><span>DJI</span><span>Premiere</span><span>After Effects</span><span>DaVinci</span></div>
            </div>
          </div>

          <div class="bento-card svc svc--growth reveal-card">
            <div class="svc-copy">
              <span class="svc-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icons.chip} /></span>
              <h3>Marketing e IA</h3>
              <p>Campañas, redes y SEO, con reportes y métricas automatizados con IA.</p>
            </div>
            <div class="svc-chart" aria-hidden="true">
              {[38, 52, 46, 64, 58, 78, 92].map((h, i) => (
                <span style={`--h:${h}%; --i:${i}`} class={i === 6 ? 'is-now' : ''}></span>
              ))}
            </div>
          </div>

          <div class="bento-card svc svc--web reveal-card">
            <div class="svc-copy">
              <span class="svc-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icons.brackets} /></span>
              <h3>Desarrollo web</h3>
              <p>Sitios corporativos y landing pages rápidos, responsivos y con animaciones fluidas.</p>
              <div class="svc-chips"><span>HTML5</span><span>CSS3</span><span>JavaScript</span><span>GSAP</span><span>Astro</span></div>
            </div>
            <div class="svc-browser" aria-hidden="true">
              <div class="svc-browser-bar"><i></i><i></i><i></i><span></span></div>
              <div class="svc-browser-body">
                <span class="sk sk--hero"></span>
                <span class="sk sk--line"></span>
                <span class="sk sk--line sk--short"></span>
                <div class="sk-row"><span class="sk sk--card"></span><span class="sk sk--card"></span><span class="sk sk--card"></span></div>
